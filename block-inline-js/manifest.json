{
  "manifest_version": 3,
  "name": "JavaScript Policy Inspector",
  "version": "0.3.2",
  "description": "Per-site JavaScript control: monitor, allow first-party, or block entirely. See what loads, allow only what you trust.",
  "minimum_chrome_version": "101",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest", "webRequest"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "JS Policy Inspector"
  }
}
