{
  "manifest_version": 3,
  "name": "JavaScript Policy Inspector",
  "version": "0.1.0",
  "description": "Per-site JavaScript policies: Observe, First-party only, No scripts. Injected via CSP headers; scripts are inventoried and block reasons explained.",
  "minimum_chrome_version": "101",
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest", "webRequest"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JS Policy Inspector"
  }
}
