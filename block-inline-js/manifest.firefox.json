{
  "manifest_version": 3,
  "name": "JavaScript Policy Inspector",
  "version": "0.6.7",
  "description": "Per-site JavaScript control: per-category flags for inline, third-party, import maps and JSON-LD, plus a forensic activity log.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "declarativeNetRequest", "webRequest", "webNavigation"],
  "host_permissions": ["*://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "javascript-policy-inspector@akamai",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["service-worker.bundled.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "JS Policy Inspector"
  }
}
